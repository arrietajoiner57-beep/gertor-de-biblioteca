# Copia este archivo como `backend/.env` y ajusta los valores
# cp .env.example .env   (o copia y renombra manualmente)

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=biblioteca
PORT=4000

# Clave para firmar los tokens de sesión (cámbiala en producción)
JWT_SECRET=cambia-esta-clave
TOKEN_EXPIRA_EN=8h

# Administrador inicial (usado por: npm run seed)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@biblioteca.com
ADMIN_CONTRASENA=admin123
ADMIN_TELEFONO=
ADMIN_DIRECCION=