{
  "name": "proyecto-biblioteca",
  "version": "1.0.0",
  "description": "Sistema de biblioteca (React + Express + MySQL)",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "db": "c:\\xampp\\mysql\\bin\\mysql.exe -u root < database\\schema.sql",
    "db:migrate": "c:\\xampp\\mysql\\bin\\mysql.exe -u root --default-character-set=utf8mb4 < database\\migration_auth.sql",
    "db:migrate:roles": "c:\\xampp\\mysql\\bin\\mysql.exe -u root --default-character-set=utf8mb4 < database\\migration_bibliotecario.sql",
    "db:migrate:estados": "c:\\xampp\\mysql\\bin\\mysql.exe -u root --default-character-set=utf8mb4 < database\\migration_pendiente_status.sql",
    "db:seed-wow": "c:\\xampp\\mysql\\bin\\mysql.exe -u root --default-character-set=utf8mb4 < database\\seed_wow.sql",
    "db:seed-prestamos": "c:\\xampp\\mysql\\bin\\mysql.exe -u root --default-character-set=utf8mb4 < database\\seed_prestamos.sql",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "seed": "npm run seed --prefix backend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm start --prefix frontend",
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
